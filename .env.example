# ==============================================================================
# DEEDFLOW PRODUCTION & PILOT ENVIRONMENT VARIABLES
# ==============================================================================

# Google Gemini API Key (Server-side in-memory KYC OCR parsing)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase PostgreSQL (Optional - Defaults to local-first browser demo mode if unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payments (Optional - Dormant by default during free beta pilots)
ENABLE_PAYMENTS=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Verification Host
NEXT_PUBLIC_APP_URL=http://localhost:3000
