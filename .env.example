# ==============================================================================
# DEEDFLOW ENTERPRISE PRODUCTION & ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini 2.5 Flash AI Engine
# Used for in-memory zero-retention KYC OCR (PAN, Masked Aadhaar) & site register parsing.
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Cloud PostgreSQL Database
# Run scripts/seed-database.sql in your Supabase SQL editor to create all tables & RPCs.
# Staging / Preview: Create 'deedflow-staging'
# Production: Create 'deedflow-prod'
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 3. Transactional Email Dispatch (Resend)
# Used for legal approval notifications, buyer execution dossiers, & bank kit dispatches.
# Get your API key from: https://resend.com/
# Defaults to audit-logged simulation if unset.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
SYSTEM_EMAIL_FROM=DeedFlow Post-Sales <notifications@deedflow.in>

# ------------------------------------------------------------------------------
# 4. Razorpay Payments & Indian Billing (Optional)
# Set ENABLE_PAYMENTS=true when activating live billing. Dormant during beta pilots.
# ------------------------------------------------------------------------------
ENABLE_PAYMENTS=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ------------------------------------------------------------------------------
# 5. Canonical Application URL
# Used for generating QR code validation URLs and email deep links.
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
